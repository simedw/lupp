{
  "name": "lupp",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "A local voice-first code review desk with pluggable coding agents",
  "scripts": {
    "install:local": "npm run build && node dist/scripts/install-local.js",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron dist/desktop/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.257",
    "@openai/codex-sdk": "^0.87.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^44.1.0",
    "typescript": "^7.0.2"
  }
}
